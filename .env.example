    # =============================================================================
    # PoultryGuard — Environment Configuration Template
    # =============================================================================
    # Copy this file to .env and configure your local settings:
    #   powershell: Copy-Item .env.example .env

    APP_NAME=PoultryGuard
    DATA_DIR=./data
    STORAGE_DIR=./storage
    DATABASE_PATH=./data/poultryguard.sqlite3

    # -----------------------------------------------------------------------------
    # Computer Vision & Detection Model
    # -----------------------------------------------------------------------------
    # Default model: Ultralytics YOLOv8s pretrained on MS-COCO
    MODEL_PATH=yolov8s.pt
    # Optional poultry-specific fine-tuned weights (leave empty to use generic COCO baseline)
    CUSTOM_MODEL_PATH=
    # Detection confidence threshold (0.05 - 0.50)
    DETECT_CONF=0.10
    # Inference image size (pixels)
    IMAGE_SIZE=960
    # Frame sampling stride (sample every Nth frame for fast processing on CPU)
    FRAME_STRIDE=3
    # Maximum video upload size in Megabytes
    MAX_UPLOAD_MB=500
    # Save sampled raw video frames to disk
    SAVE_FRAMES=true

    # -----------------------------------------------------------------------------
    # Spatial High-Density Screening Configuration (Default Parameters)
    # -----------------------------------------------------------------------------
    # Grid partition layout: 2x2, 3x3, or 4x4
    DENSITY_DEFAULT_LAYOUT=3x3
    # Minimum detected birds in a single zone to trigger a density event
    DENSITY_DEFAULT_COUNT_THRESHOLD=5
    # Minimum bounding-box occupied area percentage in a single zone
    DENSITY_DEFAULT_AREA_THRESHOLD_PCT=15.0
    # Minimum consecutive sampled frames the condition must persist before triggering
    DENSITY_DEFAULT_PERSISTENCE_FRAMES=2
    # Clearing threshold: bird count must drop below this number to clear the event
    DENSITY_DEFAULT_CLEARING_THRESHOLD=3

    # -----------------------------------------------------------------------------
    # SMS Notification Dispatcher Configuration
    # -----------------------------------------------------------------------------
    # Master toggle for SMS notifications: true or false (default: false for security)
    SMS_ENABLED=false

    # Provider type: 'disabled', 'mock', 'indian_gateway' (Fast2SMS), or 'twilio'
    SMS_PROVIDER=disabled

    # Default recipient mobile number (Indian 10-digit or international E.164)
    # Normalized automatically to E.164 (e.g. 7530088644 -> +917530088644)
    SMS_RECIPIENT=7530088644

    # Cooldown between duplicate SMS alerts for the same event category (seconds)
    SMS_COOLDOWN_SEC=300

    # Dry-run mode: logs notifications in SQLite audit trail without incurring carrier charge
    SMS_DRY_RUN=true

    # --- Indian Gateway (Fast2SMS) Credentials ---
    # Required only if SMS_PROVIDER=indian_gateway
    FAST2SMS_API_KEY=your_fast2sms_api_key_here
    FAST2SMS_SENDER_ID=TXTIND

    # --- Twilio SMS Gateway Credentials ---
    # Required only if SMS_PROVIDER=twilio
    TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
    TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
    TWILIO_FROM_NUMBER=your_twilio_phone_number_here

    # --- Generic Webhook / Integration Gateway ---
    # Optional webhook endpoint for external alert forwarding
    SMS_WEBHOOK_URL=
